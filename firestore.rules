rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isDocOwner(data) {
      return isSignedIn() && data.ownerUid == request.auth.uid;
    }

    function isDocEditor(data) {
      return isSignedIn() && (userEmail() in data.editorEmails);
    }

    function canReadDoc(data) {
      return isDocOwner(data) || (isSignedIn() && (userEmail() in data.sharedEmails));
    }

    function canEditDoc(data) {
      return isDocOwner(data) || isDocEditor(data);
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /documents/{docId} {
      allow read: if canReadDoc(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == userEmail()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.sharedEmails is list
        && request.resource.data.editorEmails is list
        && request.resource.data.viewerEmails is list;

      allow update: if isDocOwner(resource.data)
        || (
          isDocEditor(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'contentHtml',
            'contentJson',
            'plainTextPreview',
            'updatedAt',
            'lastEditedByEmail',
            'attachmentCount'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
        );

      allow delete: if isDocOwner(resource.data);

      match /attachments/{attachmentId} {
        function parentDoc() {
          return get(/databases/$(database)/documents/documents/$(docId)).data;
        }

        allow read: if canReadDoc(parentDoc());

        allow create: if canEditDoc(parentDoc())
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes > 0
          && request.resource.data.sizeBytes <= 512000
          && request.resource.data.base64Data is string
          && request.resource.data.base64Data.size() <= 720000
          && request.resource.data.uploadedByUid == request.auth.uid;

        allow delete: if canEditDoc(parentDoc());
      }
    }
  }
}
